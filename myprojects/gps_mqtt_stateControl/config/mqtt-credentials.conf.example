# Copy this file to mqtt-credentials.conf and replace the placeholders locally.
# mqtt-credentials.conf is loaded automatically and ignored by Git.
CONFIG_MQTT_BROKER_HOSTNAME="your-broker-hostname"
# Uncomment and set both lines together only if your broker doesn't use the
# standard TLS port 8883 already defaulted in config/mqtt.conf.
# CONFIG_MQTT_BROKER_PORT=8883
# CONFIG_MQTT_HELPER_PORT=8883
CONFIG_MQTT_BROKER_USERNAME="your_username"
CONFIG_MQTT_BROKER_PASSWORD="your_password"
