menu "LTE and MQTT Test Configuration"

config MQTT_BROKER_HOSTNAME
	string "MQTT broker hostname"
	default "test.mosquitto.org"
	help
	  Hostname or IP address of the MQTT broker.

config MQTT_PUB_TOPIC
	string "MQTT publish topic"
	default "nrf91/test/data"
	help
	  Topic used for the periodic test message.

config MQTT_CLIENT_ID
	string "MQTT client ID (leave blank to use IMEI)"
	default ""
	help
	  If empty, the application creates nrf-<IMEI> from AT+CGSN.

config MQTT_TEST_PAYLOAD
	string "MQTT test payload"
	default "{\"message\":\"hello from nRF91\"}"
	help
	  Payload published on every test interval.

config MQTT_PUBLISH_INTERVAL_SECONDS
	int "MQTT publish interval in seconds"
	range 1 86400
	default 30
	help
	  Delay between test messages after the MQTT connection is accepted.

config LTE_CONNECT_TIMEOUT_SECONDS
	int "LTE registration timeout in seconds"
	range 1 1800
	default 180

config MQTT_CONNECT_TIMEOUT_SECONDS
	int "MQTT CONNACK timeout in seconds"
	range 1 300
	default 30

endmenu

menu "Zephyr Kernel"
source "Kconfig.zephyr"
endmenu

