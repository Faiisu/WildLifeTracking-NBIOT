# Copy this file to mqtt-credentials.conf and replace the values locally.
# The local file is loaded automatically and ignored by Git.
CONFIG_MQTT_TEST_BROKER_HOSTNAME="your-cluster.s1.eu.hivemq.cloud"
CONFIG_MQTT_TEST_BROKER_PORT=8883
CONFIG_MQTT_HELPER_PORT=8883
CONFIG_MQTT_TEST_CLIENT_ID="mqtt-connection-test"
CONFIG_MQTT_TEST_USERNAME="your_username"
CONFIG_MQTT_TEST_PASSWORD="your_password"
