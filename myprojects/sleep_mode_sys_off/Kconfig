menu "Sleep Mode 2: nRF9160 System OFF + Motion Wake-up"

config SLEEP_APP_LTE_CONNECT_TIMEOUT_SECONDS
	int "LTE registration timeout in seconds"
	default 30
	range 10 300
	help
	  Maximum time to wait for home or roaming LTE registration. If LTE is
	  not found within this timeout, the firmware shuts down the modem and
	  goes directly to System OFF.

config SLEEP_APP_CELL_MEAS_TIMEOUT_SECONDS
	int "LTE cell location measurement timeout in seconds"
	default 30
	range 5 180
	help
	  Maximum time to wait for LTE_LC_EVT_NEIGHBOR_CELL_MEAS before
	  cancelling and entering System OFF.

config TRACKER_MAX_NEIGHBOR_CELLS
	int "Maximum neighbor cells stored per report"
	default 6
	range 0 16
	help
	  Maximum number of neighbor cells retained in each cell report JSON
	  payload.

config SLEEP_APP_MOTION_WAKEUP
	bool "Enable LIS2DH12 motion wake-up from System OFF"
	default n
	help
	  Configures the on-board LIS2DH12 accelerometer (accel0) in low-power
	  any-motion mode on INT1 (P0.29) and arms GPIO level sense before
	  entering System OFF. Disabled by default in favor of MODE button
	  (sw0) wake-up.

config SLEEP_APP_MOTION_THRESHOLD_MS2
	int "Motion wake-up threshold in m/s^2"
	default 2
	range 1 19
	depends on SLEEP_APP_MOTION_WAKEUP
	help
	  Slope acceleration threshold in m/s^2 for LIS2DH12 any-motion
	  interrupt (e.g., 2 m/s^2 is approximately 0.2 g).

config SLEEP_APP_MOTION_DURATION_SAMPLES
	int "Motion wake-up duration in ODR samples"
	default 1
	range 0 127
	depends on SLEEP_APP_MOTION_WAKEUP
	help
	  Number of consecutive ODR samples above threshold required to assert
	  the motion interrupt (at 10 Hz ODR, 1 sample is 100 ms).

config SLEEP_APP_BUTTON_WAKEUP
	bool "Also allow sw0 (MODE button) to wake from System OFF"
	default y
	help
	  Arms sw0 (P0.12) with GPIO_INT_LEVEL_ACTIVE so pressing MODE also
	  wakes the nRF9160 from System OFF on the bench.

config SLEEP_APP_STATUS_LED
	bool "Blink board LED0 while searching for LTE"
	default y
	help
	  Blinks led0 while searching for LTE so bench operation is visible
	  without a debugger. Disable (or use release.conf) during microamp
	  power measurements.

config SLEEP_APP_LTE_BLINK_INTERVAL_MS
	int "LED0 blink half-period while searching for LTE (ms)"
	default 250
	range 50 2000
	depends on SLEEP_APP_STATUS_LED
	help
	  Interval in milliseconds between LED0 toggles while waiting for LTE
	  registration.

config MQTT_BROKER_HOSTNAME
	string "MQTT Broker Hostname"
	default "test.mosquitto.org"
	help
	  Hostname or IP address of the target MQTT broker.

config MQTT_BROKER_PORT
	int "MQTT Broker Port"
	default 8883
	help
	  Port number of the target MQTT broker (1883 plaintext, 8883 TLS).

config MQTT_PUB_TOPIC
	string "MQTT Publish Topic"
	default "test/nrf91/cell"
	help
	  MQTT topic to publish LTE serving and neighbor cell measurements.

config MQTT_PUB_QOS
	int "MQTT publish QoS"
	range 0 1
	default 1
	help
	  0 sends at most once; 1 sends at least once and waits for PUBACK.

config MQTT_CLIENT_ID
	string "MQTT Client ID (leave blank to use IMEI)"
	default ""
	help
	  Custom MQTT client ID. If empty, nrf-<IMEI> is derived via AT+CGSN.

config MQTT_BROKER_USERNAME
	string "MQTT broker username"
	default ""
	help
	  Optional MQTT username. Keep real credentials in git-ignored
	  config/mqtt-credentials.conf.

config MQTT_BROKER_PASSWORD
	string "MQTT broker password"
	default ""
	help
	  Optional MQTT password (requires non-empty username). Keep real
	  credentials in git-ignored config/mqtt-credentials.conf.

endmenu

source "Kconfig.zephyr"
