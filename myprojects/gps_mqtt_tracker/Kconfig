menu "GPS MQTT Asset Tracker Configuration"

config TRACKER_VERSION_MAJOR
	int "Major version number"
	default 1

config TRACKER_VERSION_MINOR
	int "Minor version number"
	default 0

config TRACKER_VERSION_PATCH
	int "Patch version number"
	default 0

config MQTT_BROKER_HOSTNAME
	string "MQTT Broker Hostname"
	default "test.mosquitto.org"
	help
	  Hostname or IP address of the target MQTT broker.

config MQTT_BROKER_PORT
	int "MQTT Broker Port"
	default 1883
	help
	  Port number of the target MQTT broker (1883 for unencrypted, 8883 for TLS).

config MQTT_PUB_TOPIC
	string "MQTT Publish Topic"
	default "nrf91/tracker/gps"
	help
	  MQTT Topic to publish GPS location fixes.

config MQTT_PUB_QOS
	int "MQTT publish QoS"
	range 0 1
	default 1
	help
	  MQTT delivery level for location publishes: 0 sends at most once and
	  does not wait for a broker acknowledgement; 1 sends at least once and
	  waits for PUBACK. QoS 2 is not supported by this tracker flow.

config MQTT_CLIENT_ID
	string "MQTT Client ID (Leave blank to use IMEI)"
	default ""
	help
	  Custom Client ID for MQTT connection. If left empty, nrf-<IMEI> will be generated automatically.

config MQTT_BROKER_USERNAME
	string "MQTT broker username"
	default ""
	help
	  Optional username for MQTT broker authentication. Keep production
	  credentials in the ignored config/mqtt-credentials.conf overlay instead
	  of a tracked configuration file.

config MQTT_BROKER_PASSWORD
	string "MQTT broker password"
	default ""
	help
	  Optional password for MQTT broker authentication. A non-empty password
	  requires CONFIG_MQTT_BROKER_USERNAME to also be non-empty. Keep production
	  credentials in the ignored config/mqtt-credentials.conf overlay.

config TRACKER_PERIODIC_INTERVAL
	int "Periodic GPS Fix Interval (seconds)"
	range 10 65535
	default 120
	help
	  Time interval in seconds between periodic GNSS location fixes.

config TRACKER_PERIODIC_TIMEOUT
	int "Periodic GPS Fix Timeout (seconds)"
	range 0 65535
	default 300
	help
	  Time limit in seconds to search for a GNSS fix before sleeping. Set 0 for infinite search.

config TRACKER_PSM_PERIODIC_TAU_SECONDS
	int "Requested PSM periodic TAU (seconds)"
	range 0 1152000
	default 28800
	help
	  Requested interval between periodic tracking area updates while the
	  modem is in Power Saving Mode. The network may grant a different value.

config TRACKER_PSM_ACTIVE_TIME_SECONDS
	int "Requested PSM active time (seconds)"
	range 0 11160
	default 0
	help
	  Requested paging time after LTE activity before entering PSM. Use zero
	  for an uplink-only tracker that does not need to receive downlink data.

config TRACKER_PSM_ENTRY_TIMEOUT_SECONDS
	int "PSM entry timeout (seconds)"
	range 1 600
	default 60
	help
	  Maximum time to wait after an upload for confirmation that the modem
	  entered PSM. If it expires, LTE is deactivated so GNSS can continue.

config TRACKER_BACKLOG_CAPACITY
	int "Un-sent location backlog capacity"
	range 1 500
	default 40
	help
	  Maximum number of GPS fixes retained in RAM while LTE registration,
	  MQTT connect, or publish is failing. Each entry is a compact
	  struct tracker_location_fix (lat/lon/alt/acc/timestamp only, not
	  the full GNSS PVT frame), stored in a static array -- not the heap.
	  Lost on reboot or power loss; there is no flash persistence. Once
	  full, adaptive stride sampling keeps the retained set evenly spread
	  across the whole outage instead of just its most recent portion --
	  see docs/adr/0005-adaptive-stride-backlog-retention.md and
	  tracker_backlog.c.

config TRACKER_GNSS_DIAGNOSTICS
	bool "Enable detailed GNSS and NMEA diagnostics"
	default n
	help
	  Print satellite statistics, PVT search status, and NMEA sentences.
	  Disable this in battery-powered deployments to reduce application-core
	  wakeups, log traffic, and memory use.

config GNSS_LOW_ACCURACY
	bool "Allow Low Accuracy GNSS Fixes"
	default y
	help
	  Enables low accuracy mode to obtain faster satellite fixes (useful indoors or in urban canyons).

config GNSS_HIGH_ACCURACY_TIMING_SOURCE
	bool "Use TCXO Crystal Oscillator Timing Source"
	default n
	help
	  Use high accuracy TCXO crystal oscillator instead of RTC for GNSS timing.

config TRACKER_CIRCUIT_DOJO_GNSS_SETUP
	bool "Enable Circuit Dojo nRF9160 GNSS hardware setup"
	default y if BOARD_CIRCUITDOJO_FEATHER_NRF9160_NS
	default y if BOARD_SPARKFUN_THING_PLUS_NRF9160_NS
	depends on GPIO
	help
	  Drive the Circuit Dojo GNSS sample's power-mode GPIO low during
	  application startup. The matching board configuration also enables
	  the modem antenna library and its GNSS COEX0 routing command.

config TRACKER_GNSS_POWER_MODE_PIN
	int "Circuit Dojo GNSS power-mode GPIO pin"
	default 13
	range 0 31
	depends on TRACKER_CIRCUIT_DOJO_GNSS_SETUP
	help
	  GPIO0 pin used by the Circuit Dojo GNSS sample. Keep the default for
	  the nRF9160 Feather and SparkFun Thing Plus nRF9160 hardware.

config STARTUP_LED
	bool "Show tracker states with board LED blink groups"
	default y if BOARD_CIRCUITDOJO_FEATHER_NRF9160_NS
	default y if BOARD_SPARKFUN_THING_PLUS_NRF9160_NS
	depends on GPIO
	help
	  Blink the devicetree led0 LED in groups: two for GNSS finding, three
	  for LTE finding, and four for LTE registered during MQTT upload.
	  The LED is off during initialization and low-power preparation.

config WORKING_LED_BLINK_INTERVAL_MS
	int "Status LED pulse interval (milliseconds)"
	range 100 60000
	default 200
	depends on STARTUP_LED
	help
	  On time of each blink and off time between blinks within a group.

config WORKING_LED_GROUP_PAUSE_MS
	int "Status LED pause between groups (milliseconds)"
	range 100 60000
	default 1000
	depends on STARTUP_LED
	help
	  Dark time after the last blink in each group and before a new state.

config ENABLE_LEDS
	bool "Enable status LEDs"
	default n
	select DK_LIBRARY
	help
	  Enable LED visual status indicators for LTE, GNSS, and MQTT states.

endmenu

menu "Zephyr Kernel"
source "Kconfig.zephyr"
endmenu
