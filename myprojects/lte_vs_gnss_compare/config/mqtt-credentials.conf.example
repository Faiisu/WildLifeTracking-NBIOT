# Copy this file to config/mqtt-credentials.conf (git-ignored) and set your
# broker endpoint and optional authentication credentials.
CONFIG_MQTT_BROKER_HOSTNAME="your-broker.example.com"
CONFIG_MQTT_BROKER_PORT=8883
CONFIG_MQTT_HELPER_PORT=8883
CONFIG_MQTT_BROKER_USERNAME="your-username"
CONFIG_MQTT_BROKER_PASSWORD="your-password"
CONFIG_MQTT_PUB_TOPIC="test/nrf91"
CONFIG_MQTT_CLIENT_ID="WLTK01"
